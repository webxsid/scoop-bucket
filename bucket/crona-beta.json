{
  "version": "1.10.0-beta.5",
  "description": "local-first work tracker for developers",
  "homepage": "https://crona.work",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/crona-app/crona/releases/download/v1.10.0-beta.5/crona-bundle-1.10.0-beta.5-windows-amd64.zip",
      "hash": "f8d1ec6692eab38571f6d1ddd2aab625734fa3176c42b1df3bbf46b6391bf137"
    },
    "arm64": {
      "url": "https://github.com/crona-app/crona/releases/download/v1.10.0-beta.5/crona-bundle-1.10.0-beta.5-windows-arm64.zip",
      "hash": "5f5aed11c62838b7f1c7f5d3623b418000b0aba322a0602859c4fe2bd079064e"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'beta' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
