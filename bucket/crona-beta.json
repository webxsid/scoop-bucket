{
  "version": "1.10.0-beta.6",
  "description": "local-first work tracker for developers",
  "homepage": "https://crona.work",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/crona-app/crona/releases/download/v1.10.0-beta.6/crona-bundle-1.10.0-beta.6-windows-amd64.zip",
      "hash": "d157438a55eb7173a970cacc3505046fd864699d13d2491caaab3b4d05648625"
    },
    "arm64": {
      "url": "https://github.com/crona-app/crona/releases/download/v1.10.0-beta.6/crona-bundle-1.10.0-beta.6-windows-arm64.zip",
      "hash": "1aaf51ceb5c80faccae115e09f3b8c65a5df1fa92ca7704710f36f0249815a44"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'beta' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
