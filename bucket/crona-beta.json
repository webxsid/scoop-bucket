  "architecture": {
    "64bit": {
      "url": "https://github.com/crona-app/crona/releases/download/v1.10.0-beta.7/crona-bundle-1.10.0-beta.7-windows-amd64.zip",
      "hash": "7dbf21a45e3f51896ca339eb8e758f58482d332ebf0c770a081679e045efeaf8"
    },
    "arm64": {
      "url": "https://github.com/crona-app/crona/releases/download/v1.10.0-beta.7/crona-bundle-1.10.0-beta.7-windows-arm64.zip",
      "hash": "3276c994e49200717d051612cb71b9a425b298d173789174676b77766d28ab16"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'beta' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
