  "architecture": {
    "64bit": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.10.0-beta.4/crona-bundle-1.10.0-beta.4-windows-amd64.zip",
      "hash": "687b996c9ee970caa273a3d46f93a43278a314b6cdf59467411bc7b065fcf98c"
    },
    "arm64": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.10.0-beta.4/crona-bundle-1.10.0-beta.4-windows-arm64.zip",
      "hash": "35c4f48953d4949367a4431f7eced6111791bcb527a0d7c7976a7038fbfd269f"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'beta' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
