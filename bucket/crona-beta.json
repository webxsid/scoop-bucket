  "architecture": {
    "64bit": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.9.0-beta.5/crona-bundle-1.9.0-beta.5-windows-amd64.zip",
      "hash": "eb5d5d07d8c8ef5c5c2f97f27fa2d0a1856dd2a30c629bd91bf7d4c1088f9b56"
    },
    "arm64": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.9.0-beta.5/crona-bundle-1.9.0-beta.5-windows-arm64.zip",
      "hash": "55b85160f84786b4f34a03bd44344b61e195b12a4cb922d2274ed386db894a02"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'beta' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
