{
  "version": "1.10.0-beta.8",
  "description": "local-first work tracker for developers",
  "homepage": "https://crona.work",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/crona-app/crona/releases/download/v1.10.0-beta.8/crona-bundle-1.10.0-beta.8-windows-amd64.zip",
      "hash": "9f9cc463d0c9f5b7a6472128dadbdaae5dec56c41f390749eaafc9cdbf2076dd"
    },
    "arm64": {
      "url": "https://github.com/crona-app/crona/releases/download/v1.10.0-beta.8/crona-bundle-1.10.0-beta.8-windows-arm64.zip",
      "hash": "81563c36ffb7141568c76f0409f8fdf905a7979f34acddea4a5e190fdf1d5bdf"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'beta' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
