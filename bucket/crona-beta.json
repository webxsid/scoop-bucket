{
  "version": "1.10.0-beta.3",
  "description": "local-first work tracker for developers",
  "homepage": "https://crona.work",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.10.0-beta.3/crona-bundle-1.10.0-beta.3-windows-amd64.zip",
      "hash": "82de61b84e011cb5a7013b874b79691914a3eb5130f6fcce94a42e2bd74d44bd"
    },
    "arm64": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.10.0-beta.3/crona-bundle-1.10.0-beta.3-windows-arm64.zip",
      "hash": "450d3821a5d28fc89f9eb15a7b629b4d3e6789edea6b50a57eeeeb7ef3196f0c"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'beta' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
