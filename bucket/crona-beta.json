{
  "version": "1.10.0-beta.9",
  "description": "local-first work tracker for developers",
  "homepage": "https://crona.work",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/crona-app/crona/releases/download/v1.10.0-beta.9/crona-bundle-1.10.0-beta.9-windows-amd64.zip",
      "hash": "d6d014a1b152a1f51d7a1fd81ea16cef353880f3b58b9614ff09e1666532f30a"
    },
    "arm64": {
      "url": "https://github.com/crona-app/crona/releases/download/v1.10.0-beta.9/crona-bundle-1.10.0-beta.9-windows-arm64.zip",
      "hash": "9822e4febb9ada9af0f4a9c76399ab2edb8c158f064e13cda47c9ed90fff8d35"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'beta' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
