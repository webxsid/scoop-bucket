  "architecture": {
    "64bit": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.9.0-beta.7/crona-bundle-1.9.0-beta.7-windows-amd64.zip",
      "hash": "cda0ef298051e5d222c7b1d5385380666bd79b5efb744cada2744c0cb38af876"
    },
    "arm64": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.9.0-beta.7/crona-bundle-1.9.0-beta.7-windows-arm64.zip",
      "hash": "9042e5d423bf42268e87555d34a502312bbd88613096b19be34e410a95d5d703"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'beta' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
