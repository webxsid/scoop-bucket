{
  "version": "1.10.0-beta.1",
  "description": "local-first work tracker for developers",
  "homepage": "https://crona.work",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.10.0-beta.1/crona-bundle-1.10.0-beta.1-windows-amd64.zip",
      "hash": "1ebad0b22accf76d16153636e40486c99e308dd7e695f9cf5c8d15076a286dbb"
    },
    "arm64": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.10.0-beta.1/crona-bundle-1.10.0-beta.1-windows-arm64.zip",
      "hash": "a244274f050db7fc53d86808adfdcd143ec8aad2a678f8e118f1c5ffadd7e620"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'beta' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
