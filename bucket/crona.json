{
  "version": "1.8.0",
  "description": "local-first work tracker for developers",
  "homepage": "https://crona.work",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.8.0/crona-bundle-1.8.0-windows-amd64.zip",
      "hash": "6747a9857e56488825c55816bbd41ae0ea63622be53f4c5ee64ab38439114b8b"
    },
    "arm64": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.8.0/crona-bundle-1.8.0-windows-arm64.zip",
      "hash": "952271a0bebf77ccecc020e69852f0f56cdc239ea795bddf01ec3e07f62a0c20"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'stable' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
