{
  "version": "1.7.2",
  "description": "local-first work tracker for developers",
  "homepage": "https://crona.work",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.7.2/crona-bundle-1.7.2-windows-amd64.zip",
      "hash": "5efa3c3cbf36f23f1c1a7f3677ccc7da2cc39ee187e38934535de0b262c47a9e"
    },
    "arm64": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.7.2/crona-bundle-1.7.2-windows-arm64.zip",
      "hash": "6a2f348d229bf82a4356862291360b94549402f8161090c7a9d7d740b293e093"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'stable' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
