{
  "version": "1.7.0",
  "description": "local-first work tracker for developers",
  "homepage": "https://crona.work",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.7.0/crona-bundle-1.7.0-windows-amd64.zip",
      "hash": "2512660135b39c1e3376408dfc584274e7bf5ef1a54b1d0d6aaf3d7ab8621504"
    },
    "arm64": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.7.0/crona-bundle-1.7.0-windows-arm64.zip",
      "hash": "b9c909f885a1163ca89ee3ea37fb27cee15d5a1f30094f13a8afc2b011f7a4e1"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'stable' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
