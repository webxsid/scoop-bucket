{
  "version": "1.7.1",
  "description": "local-first work tracker for developers",
  "homepage": "https://crona.work",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.7.1/crona-bundle-1.7.1-windows-amd64.zip",
      "hash": "f1c145da52517c9f7028892c71faaa3c6472f7ab201a31737eed0468752c5138"
    },
    "arm64": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.7.1/crona-bundle-1.7.1-windows-arm64.zip",
      "hash": "2ec3b0c386ffd12228ddbd446a6d229e5a3f3daf341c186958dff2aa4e0f0c28"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'stable' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
