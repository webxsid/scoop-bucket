{
  "version": "1.9.0",
  "description": "local-first work tracker for developers",
  "homepage": "https://crona.work",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.9.0/crona-bundle-1.9.0-windows-amd64.zip",
      "hash": "71044a55714d301db04366749961174a6b71bdf2919419a00d9cd597c3d47000"
    },
    "arm64": {
      "url": "https://github.com/webxsid/crona/releases/download/v1.9.0/crona-bundle-1.9.0-windows-arm64.zip",
      "hash": "b14e238e8a56b541cf0a5cc8fd53fef49f70ca1908724e1d8be9ff3271f6d98c"
    }
  },
  "post_install": [
    "$runtimeDir = Join-Path $env:LOCALAPPDATA 'Crona'",
    "New-Item -ItemType Directory -Force -Path $runtimeDir | Out-Null",
    "$installRecord = @{ installSource = 'scoop'; releaseChannel = 'stable' } | ConvertTo-Json -Compress",
    "Set-Content -Path (Join-Path $runtimeDir 'install.json') -Value $installRecord -NoNewline"
  ],
  "bin": [
    "crona.exe",
    "crona-daemon.exe",
    "crona-tui.exe"
  ]
}
